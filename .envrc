# direnv config for local release tooling.
# Loads git-ignored secrets from .env.local (never committed).
# Create .env.local with:
#   GH_TOKEN=<your GitHub token with write access to the release repo>
# Then run: direnv allow
dotenv_if_exists .env.local

# Non-secret default so release scripts target the right repository.
export TERAX_REPOSITORY="${TERAX_REPOSITORY:-Sendery/terax-ai}"
