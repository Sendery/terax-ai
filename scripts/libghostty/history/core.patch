+/// Install an exact row policy without reserving future history capacity.
+pub fn setHistoryLimitRows(self: *Screen, max_rows: usize) void {
+    self.history_limit_rows = max_rows;
+    // Keep growth on the eviction-aware path even when the row limit is zero.
+    self.no_scrollback = false;
+    self.pages.explicit_max_size = std.math.maxInt(usize);
+    self.enforceHistoryLimit();
+}
+
+fn enforceHistoryLimit(self: *Screen) void {
+    const limit = self.history_limit_rows orelse return;
+    const history = self.pages.total_rows - self.pages.rows;
+    if (history <= limit) return;
+    const excess = history - limit;
+
+    if (self.selection) |*sel| {
+        const start = sel.start();
+        const end = sel.end();
+        const start_y = self.pages.pointFromPin(.screen, start).?.screen.y;
+        const end_y = self.pages.pointFromPin(.screen, end).?.screen.y;
+        if (start.garbage or end.garbage or
+            (start_y < excess and end_y < excess))
+        {
+            self.clearSelection();
+        } else {
+            if (start_y < excess) {
+                var clipped = self.pages.pin(.{ .screen = .{
+                    .y = @intCast(excess),
+                } }).?;
+                clipped.x = if (sel.rectangle) @min(start.x, clipped.node.cols() - 1) else 0;
+                sel.startPtr().* = clipped;
+                self.dirty.selection = true;
+            }
+            if (end_y < excess) {
+                var clipped = self.pages.pin(.{ .screen = .{
+                    .y = @intCast(excess),
+                } }).?;
+                clipped.x = if (sel.rectangle) @min(end.x, clipped.node.cols() - 1) else 0;
+                sel.endPtr().* = clipped;
+                self.dirty.selection = true;
+            }
+        }
+    }
+
+    self.pages.pruneHistoryRows(limit);
+    self.cursorReload();
+    if (comptime build_options.kitty_graphics) {
+        self.kitty_images.pruneGarbagePlacements(self);
         self.kitty_images.dirty = true;
     }
 }
