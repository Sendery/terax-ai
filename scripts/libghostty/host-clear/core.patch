+/// Prepare a prompt-row grid without mutating the current screen.
+pub fn cloneCursorRow(self: *const Screen) !Screen {
+    var result: Screen = result: {
+        var pages = try self.pages.clone(self.alloc, .{
+            .top = .{ .active = .{ .y = self.cursor.y } },
+            .bot = .{ .active = .{ .y = self.cursor.y } },
+        });
+        errdefer pages.deinit();
+        const pin = try pages.trackPin(pages.pin(.{
+            .active = .{ .x = self.cursor.x },
+        }).?);
+        const rac = pin.rowAndCell();
+        break :result .{
+            .alloc = self.alloc,
+            .pages = pages,
+            .no_scrollback = self.no_scrollback,
+            .cursor = .{
+                .x = self.cursor.x,
+                .y = 0,
+                .page_pin = pin,
+                .page_row = rac.row,
+                .page_cell = rac.cell,
+            },
+        };
+    };
+    errdefer result.deinit();
+    var cursor = self.cursor;
+    cursor.y = 0;
+    try result.cursorCopy(cursor, .{ .hyperlink = false });
+    if (self.cursor.hyperlink) |link|
+        try result.startHyperlinkValue(link.*);
+    result.assertIntegrity();
+    return result;
+}
