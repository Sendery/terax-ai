     fn clearPlacements(self: *ImageStorage, s: *terminal.Screen) void {
         var it = self.placements.iterator();
         while (it.next()) |entry| entry.value_ptr.deinit(s);
         self.placements.clearRetainingCapacity();
     }
 
+    /// Remove placements whose tracked history anchor was evicted.
+    pub fn pruneGarbagePlacements(self: *ImageStorage, s: *terminal.Screen) void {
+        const before = self.placements.count();
+        var it = self.placements.iterator();
+        while (it.next()) |entry| {
+            switch (entry.value_ptr.location) {
+                .virtual => continue,
+                .pin => |p| if (!p.garbage) continue,
+            }
+            entry.value_ptr.deinit(s);
+            self.placements.removeByPtr(entry.key_ptr);
+        }
+        if (self.placements.count() != before) self.markMutated();
+    }
