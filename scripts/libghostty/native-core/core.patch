+/// C: ghostty_terminal_set_scrollback_limit_rows
+pub fn set_scrollback_limit_rows(
+    terminal_: Terminal,
+    max_rows: usize,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const primary = t.screens.get(.primary).?;
+    if (max_rows > std.math.maxInt(u32) - std.math.maxInt(size.CellCountInt))
+        return .invalid_value;
+    primary.setHistoryLimitRows(max_rows);
+    t.flags.dirty.clear = true;
+    return .success;
+}
+
+/// C: ghostty_terminal_clear_preserving_cursor_row
+pub fn clear_preserving_cursor_row(
+    terminal_: Terminal,
+    out_cleared: ?*bool,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const changed = wrapper.terminal.clearHost() catch |err|
+        return if (err == error.OutOfMemory) .out_of_memory else .out_of_space;
+    if (out_cleared) |out| out.* = changed;
+    return .success;
+}
