+/// Clear the active buffer, retaining its complete cursor row and terminal modes.
+/// Allocation failure leaves the current buffer and references unchanged.
+pub fn clearHost(self: *Terminal) !bool {
+    const screen = self.screens.active;
+    if (screen.pages.total_rows == screen.pages.rows and screen.cursor.y == 0)
+        return false;
+
+    var replacement = try screen.cloneCursorRow();
+    defer replacement.deinit();
+
+    screen.clearSelection();
+    if (comptime build_options.kitty_graphics)
+        screen.kitty_images.clearHostPlacements(screen);
+    std.mem.swap(PageList, &screen.pages, &replacement.pages);
+    std.mem.swap(Screen.Cursor, &screen.cursor, &replacement.cursor);
+    screen.cursorReload();
+    screen.dirty.selection = true;
+    self.screens.generations.put(self.screens.active_key, self.screens.generation(self.screens.active_key) +% 1);
+    self.flags.dirty.clear = true;
+    return true;
+}
