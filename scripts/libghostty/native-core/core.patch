+/**
+ * Set the primary screen's exact physical history row limit.
+ *
+ * Replaces byte-budget retention for this screen and immediately evicts the
+ * oldest excess rows. Active rows are excluded. Zero disables history.
+ * Raising the limit allocates no history and does not restore evicted rows.
+ * The policy survives reset, resize and alternate-screen switches.
+ *
+ * Tracked references to evicted rows become invalid; retained references remain
+ * attached to their contents. A crossing selection is clipped and a wholly
+ * evicted selection is cleared. The viewport clamps only if its rows were lost.
+ *
+ * This extension is additive and leaves GhosttyTerminalOptions unchanged.
+ * Returns GHOSTTY_INVALID_VALUE for NULL or an unrepresentable row limit.
+ *
+ * @ingroup terminal
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_set_scrollback_limit_rows(
+    GhosttyTerminal terminal, size_t max_rows);
+
+/**
+ * Clear the active buffer while retaining the complete cursor row as row zero.
+ *
+ * Preserves X, pending wrap, current pen, modes, margins and saved cursor.
+ * Clears history and fills following rows with default cells. References and
+ * selections in this buffer are invalidated; the inactive buffer is untouched.
+ * Image placements are cleared, but transmitted images remain reusable.
+ * No PTY input is sent. Allocation failure leaves the existing buffer intact.
+ *
+ * If history is empty and Y is already zero, this is a true no-op.
+ * On success, optional out_cleared reports whether storage actually changed.
+ * This is an additive Terax host-clear-v1 extension.
+ *
+ * @ingroup terminal
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_clear_preserving_cursor_row(
+    GhosttyTerminal terminal, bool* out_cleared);
